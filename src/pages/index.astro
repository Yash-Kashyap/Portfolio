---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import SideRail from '../components/SideRail.astro';
import FloatingPill from '../components/FloatingPill.astro';
import MobileWhatsApp from '../components/MobileWhatsApp.astro';
import MobileMenu from '../components/MobileMenu.astro';
import Hero from '../components/Hero.astro';
import Statement from '../components/Statement.astro';
import Work from '../components/Work.astro';
import Services from '../components/Services.astro';
import Process from '../components/Process.astro';
import About from '../components/About.astro';
import Mission from '../components/Mission.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import Toast from '../components/Toast.astro';
import Guide from '../components/Guide.astro';
---

<Base>
  <div
    style="position:relative;min-height:100vh;background:var(--paper);color:var(--ink);font-family:'Inter Tight',system-ui,sans-serif;font-size:17px;line-height:1.5;overflow-x:clip"
  >
    <Header />
    <SideRail />
    <FloatingPill />
    <MobileWhatsApp />
    <MobileMenu />

    <main id="main">
      <Hero />
      <Statement />
      <Work />
      <Services />
      <Process />
      <About />
      <Mission />
      <Contact />
    </main>

    <Footer />
    <Toast />
    <Guide />
  </div>
</Base>

<script>
  import { initClock } from '../scripts/clock';
  import { initCursor } from '../scripts/cursor';
  import { initPolaroid } from '../scripts/polaroid';
  import { initTilt } from '../scripts/tilt';
  import { initMissionAndServices } from '../scripts/mission';
  import { initReturningVisitorToast } from '../scripts/toast';
  import { initGuide } from '../scripts/guide';
  import { initScroll } from '../scripts/scroll';

  initClock();
  initCursor();
  initPolaroid();
  initTilt();
  initMissionAndServices();
  initReturningVisitorToast();
  const guideManager = initGuide();
  initScroll(guideManager);
</script>

