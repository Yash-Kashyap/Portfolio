---
import type { Project } from '../data/site';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const isOdd = index % 2 !== 0;
const ml = isOdd ? 'auto' : '0';
const bLeft = isOdd ? '16%' : '0%';
const pLeft = isOdd ? '0%' : '74%';
const mAlign = isOdd ? 'flex-start' : 'flex-end';
const tagBorder = project.ph ? 'dashed' : 'solid';
const caseHref = project.caseHref || `#work-${index}`;
const caseLabel = project.caseHref ? 'Case study →' : 'Case study — soon';
const caseColor = project.caseHref ? 'var(--ink)' : 'var(--mute)';

const isDarkSite = project.n === '01' || project.n === '06';
const phoneBarBg = isDarkSite
  ? project.n === '01'
    ? '#1a1614'
    : '#131210'
  : project.n === '02'
    ? '#fbf7f1'
    : project.n === '05'
      ? '#f5f2eb'
      : '#f9f6ee';
const phoneBarColor = isDarkSite ? '#ffffff' : '#141210';
const phoneNotchBg = isDarkSite ? '#000000' : '#141210';
---
<article
  id={`work-${index}`}
  data-frame=""
  style={`scroll-margin-top:80px;width:var(--fw);margin-left:${ml}`}
>
  <!-- Desktop Mockup -->
  <div style="display:var(--desk-d)">
    <div data-view="" style="position:relative;aspect-ratio:16 / 11.2;width:100%">
      <!-- Browser window -->
      <div
        data-rv="wipe"
        style={`position:absolute;top:0;left:${bLeft};width:84%;border-radius:12px;overflow:hidden;border:1px solid var(--hair);background:var(--surf);box-shadow:0 40px 80px -50px rgba(0,0,0,.5)`}
      >
        <div
          style="height:34px;display:flex;align-items:center;gap:6px;padding:0 12px;border-bottom:1px solid var(--hair)"
        >
          <span style="width:9px;height:9px;border-radius:50%;background:var(--hair)"></span>
          <span style="width:9px;height:9px;border-radius:50%;background:var(--hair)"></span>
          <span style="width:9px;height:9px;border-radius:50%;background:var(--hair)"></span>
          <span
            style="margin:0 auto;padding:3px 14px;border-radius:999px;background:var(--paper);font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.04em;color:var(--mute)"
          >
            {project.host}
          </span>
        </div>
        <div
          data-bbody=""
          style="position:relative;aspect-ratio:2540 / 1520;overflow:hidden;background:repeating-linear-gradient(135deg,var(--hair) 0 1px,transparent 1px 10px)"
        >
          <span
            style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--mute)"
          >
            Loading live site — {project.host}
          </span>
          <img
            src={project.dImg}
            alt={`${project.name} desktop screenshot`}
            loading="lazy"
            style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 0;display:block"
          />
        </div>
      </div>

      <!-- Phone mockup with parallax -->
      <div
        data-parallax=""
        style={`position:absolute;bottom:0;left:${pLeft};width:26%;z-index:2`}
      >
        <div
          data-rv="wipe"
          style="border-radius:34px;border:7px solid #141210;background:#141210;overflow:hidden;box-shadow:0 40px 70px -30px rgba(0,0,0,.55);display:flex;flex-direction:column"
        >
          <div
            style={`height:24px;flex:none;display:flex;justify-content:space-between;align-items:center;padding:0 14px;background:${phoneBarBg};color:${phoneBarColor};font-family:'Inter Tight',sans-serif;font-size:11px;font-weight:600`}
          >
            <span>9:41</span>
            <span style={`width:48px;height:12px;border-radius:999px;background:${phoneNotchBg}`}></span>
            <span style="font-family:'JetBrains Mono',monospace;font-size:9px">●●● ▮</span>
          </div>
          <div
            data-pbody=""
            style={`position:relative;width:100%;aspect-ratio:1170 / 1992;overflow:hidden;border-radius:0 0 26px 26px;background:${phoneBarBg}`}
          >
            <img
              src={project.mImg}
              alt={`${project.name} mobile screenshot`}
              loading="lazy"
              style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 0;display:block"
            />
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile Mockup -->
  <div style="display:var(--mob-d)">
    <div data-view="" style="display:flex;flex-direction:column;gap:16px;width:100%">
      <div
        style={`width:62%;align-self:${mAlign};border-radius:30px;border:6px solid #141210;background:#141210;overflow:hidden;display:flex;flex-direction:column`}
      >
        <div
          style={`height:22px;flex:none;display:flex;justify-content:space-between;align-items:center;padding:0 12px;background:${phoneBarBg};color:${phoneBarColor};font-size:11px;font-weight:600`}
        >
          <span>9:41</span>
          <span style={`width:44px;height:10px;border-radius:999px;background:${phoneNotchBg}`}></span>
          <span style="font-family:'JetBrains Mono',monospace;font-size:9px">●●● ▮</span>
        </div>
        <div
          data-pbody=""
          style={`position:relative;width:100%;aspect-ratio:1170 / 1992;overflow:hidden;border-radius:0 0 22px 22px;background:${phoneBarBg}`}
        >
          <img
            src={project.mImg}
            alt={`${project.name} mobile screenshot`}
            loading="lazy"
            style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 0;display:block"
          />
        </div>
      </div>
      <div
        style="border-radius:10px;overflow:hidden;border:1px solid var(--hair);background:var(--surf)"
      >
        <div
          style="height:26px;display:flex;align-items:center;justify-content:center;border-bottom:1px solid var(--hair);font-family:'JetBrains Mono',monospace;font-size:9px;color:var(--mute)"
        >
          {project.host}
        </div>
        <div
          data-bbody=""
          style="position:relative;aspect-ratio:2540 / 1520;overflow:hidden;background:#fff"
        >
          <img
            src={project.dImg}
            alt={`${project.name} desktop screenshot`}
            loading="lazy"
            style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 0;display:block"
          />
        </div>
      </div>
    </div>
  </div>

  <!-- Text block -->
  <div style="margin-top:48px;display:grid;gap:16px">
    <h3
      style="margin:0;font-family:'Instrument Serif',serif;font-weight:400;font-size:var(--d-l);line-height:.95;letter-spacing:-.03em"
    >
      <em style="color:var(--acc);font-size:.5em;vertical-align:.7em;margin-right:.2em">
        {project.n}
      </em>
      {project.name}
    </h3>
    <div
      style="display:flex;flex-wrap:wrap;gap:8px 16px;align-items:center;font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.08em;text-transform:uppercase"
    >
      <span>{project.meta}</span>
      <span style={`padding:3px 8px;border:1px ${tagBorder} var(--ink);border-radius:4px`}>
        {project.tag}
      </span>
    </div>
    <p style="margin:0;max-width:560px;font-size:18px;color:var(--ink);text-wrap:pretty">
      {project.outcome}
    </p>
    <div style="display:flex;flex-wrap:wrap;gap:8px">
      {project.features.map((f) => (
        <span
          style="padding:7px 12px;border:1px solid var(--hair);border-radius:999px;font-size:13px;line-height:1.2"
        >
          {f}
        </span>
      ))}
    </div>
    <div
      style="display:flex;gap:28px;margin-top:8px;font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.08em;text-transform:uppercase"
    >
      <a
        href={project.url}
        target="_blank"
        rel="noopener noreferrer"
        style="border-bottom:1px solid currentColor;padding-bottom:3px"
      >
        Visit live site ↗
      </a>
      <a
        href={caseHref}
        style={`border-bottom:1px solid var(--hair);padding-bottom:3px;color:${caseColor}`}
      >
        {caseLabel}
      </a>
    </div>
  </div>
</article>

