---
import { POSE_NAMES } from '../data/site';
---
<!-- Big Guide -->
<div
  id="guide"
  style="position:fixed;left:0;bottom:0;z-index:40;width:var(--gw);height:var(--gh);pointer-events:none;will-change:transform;opacity:0"
>
  <div
    id="guide-face"
    title="Hide Yash’s tour"
    style="position:absolute;inset:0;pointer-events:auto;cursor:pointer;transform-origin:50% 100%;border-radius:22px;filter:drop-shadow(0 24px 30px rgba(0,0,0,.55))"
  >
    {POSE_NAMES.map((name) => (
      <img
        src={`/assets/poses3d/${name}.png`}
        data-pose={name}
        alt=""
        draggable="false"
        style="position:absolute;left:0;right:0;bottom:0;width:100%;height:100%;object-fit:contain;object-position:50% 100%;display:block;opacity:0;transform:scale(0.94,0.94) translateY(4%);transform-origin:50% 100%;filter:blur(6px);transition:opacity .7s cubic-bezier(.22,1,.36,1),transform .9s cubic-bezier(.22,1,.36,1),filter .7s cubic-bezier(.22,1,.36,1);will-change:opacity,transform"
      />
    ))}
  </div>
</div>

<!-- Mini Face -->
<button
  id="guide-mini"
  aria-label="Hide Yash’s tour"
  style="position:fixed;left:calc(var(--rail) + var(--gx));bottom:var(--mini-b);z-index:41;width:64px;height:64px;padding:0;border-radius:50%;border:2px solid var(--ink);background:#0F0E0C url(/assets/poses3d/face.png) 50% 30% / cover no-repeat;cursor:pointer;transform:scale(0);box-shadow:0 14px 30px -12px rgba(0,0,0,.6)"
></button>

<!-- Speech Bubble -->
<div
  id="guide-bubble"
  role="status"
  aria-live="polite"
  style="position:fixed;left:0;bottom:0;z-index:42;width:max-content;max-width:min(280px,60vw);padding:12px 14px;border-radius:16px;background:var(--ink);color:var(--paper);font-size:14px;line-height:1.35;box-shadow:0 20px 40px -20px rgba(0,0,0,.6);pointer-events:none;opacity:0;transition:opacity .3s"
>
  <span
    id="guide-tag"
    style="display:block;margin-bottom:4px;font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--acc)"
  >
    Yash · tour guide
  </span>
  <span id="guide-text"></span><span style="display:inline-block;width:2px;height:1em;margin-left:2px;vertical-align:-.15em;background:var(--acc);animation:blink 1s infinite"></span>
</div>

