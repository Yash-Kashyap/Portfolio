<div
  id="toast"
  role="status"
  style="position:fixed;left:50%;bottom:28px;z-index:80;transform:translateX(-50%);display:flex;align-items:center;gap:14px;padding:12px 18px;border-radius:999px;background:var(--ink);color:var(--paper);font-size:14px;box-shadow:0 20px 40px -20px rgba(0,0,0,.5);white-space:nowrap;opacity:0;pointer-events:none;transition:opacity .3s"
>
  <span style="width:7px;height:7px;border-radius:50%;background:var(--acc)"></span>
  <span id="toast-text"></span>
  <a
    id="toast-link"
    href="#work-4"
    class="hidden"
    style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--acc)"
  >
    Show me →
  </a>
</div>

