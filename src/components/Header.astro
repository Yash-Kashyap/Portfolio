---
---
<header
  id="header"
  style="position:fixed;top:0;left:var(--rail);right:0;z-index:50;height:64px;padding:0 var(--gx);display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:24px;background:color-mix(in oklab,var(--paper) 86%,transparent);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-bottom:1px solid var(--hair);transition:transform .5s cubic-bezier(.2,.7,0,1),background-color .6s"
>
  <a
    href="#top"
    style="font-family:'JetBrains Mono',monospace;font-size:12px;font-weight:500;letter-spacing:.08em;text-transform:uppercase;color:var(--ink)"
  >
    Yash Kashyap ©
  </a>
  <div
    style="display:var(--desk-d);align-items:center;gap:10px;font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.08em;text-transform:uppercase"
  >
    <span style="width:8px;height:8px;border-radius:50%;background:var(--acc);animation:pulse 2s infinite"></span>
    <span>Available — taking 2 projects</span>
  </div>
  <div
    style="display:var(--desk-d);justify-content:flex-end;align-items:center;gap:28px;font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.08em;text-transform:uppercase"
  >
    <span style="color:var(--mute);white-space:nowrap">
      Nahan, IN <span data-clock="hms" style="color:var(--ink)"></span> IST
    </span>
    <nav style="display:flex;gap:20px" aria-label="Primary">
      <a href="#work"><span style="color:var(--acc)">01</span> Work</a>
      <a href="#process"><span style="color:var(--acc)">02</span> Process</a>
      <a href="#about"><span style="color:var(--acc)">03</span> About</a>
      <a href="#contact"><span style="color:var(--acc)">04</span> Contact</a>
    </nav>
  </div>
  <div style="display:var(--mob-d);grid-column:3;justify-content:flex-end">
    <button
      id="open-menu-btn"
      aria-label="Open menu"
      style="background:none;border:1px solid var(--hair);border-radius:999px;color:var(--ink);padding:8px 14px;font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.08em;text-transform:uppercase;cursor:pointer"
    >
      Menu
    </button>
  </div>
</header>

